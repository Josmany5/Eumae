# Every environment variable Eumae reads today, in one place, and no values in
# it.
#
# Copy this file to `.env.local` to run against the real services, or let Vercel
# write that file for you: `vercel env pull .env.local`. `.env` and `.env.local`
# are both ignored by git; this file is not, because its whole job is to be read.
#
# The middle four are server-only. They are read inside `api/ai.ts`, which runs
# as a Vercel function, and none of them is ever copied into a response or into
# the built JavaScript — the browser holds no AI key at all, which is the reason
# the server exists.

# Chat: replies, streaming, and image generation — a Google AI Studio key.
GEMINI_API_KEY=

# Read aloud. A Cloud Text-to-Speech key, and NOT the same key as the one above;
# nothing can be spoken without it.
GOOGLE_CLOUD_TTS_KEY=

# Every /api/ai call carries a signed-in person's token and is checked against
# this project before the action runs.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# The same Supabase project again, for the browser: `src/auth.ts` signs someone
# in with these and hands the resulting token to /api/ai. Vite inlines anything
# with this prefix into the built JavaScript, so both are public by definition —
# the anon key is *designed* to be published, and row-level security is what
# protects the data. Nothing secret may ever be given this prefix.
#
# A deployment needs these as their own Vercel variables, and a build reads them
# at build time: a site built without them shows a sign-in screen that says the
# build has no sign-in configured, which is exactly what it is.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

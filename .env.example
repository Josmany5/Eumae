# Every environment variable Eumae reads today, in one place, and no values in
# it.
#
# Copy this file to `.env.local` to run against the real services, or let Vercel
# write that file for you: `vercel env pull .env.local`. `.env` and `.env.local`
# are both ignored by git; this file is not, because its whole job is to be read.
#
# All four are server-only. They are read inside `api/ai.ts`, which runs as a
# Vercel function, and none of them is ever copied into a response or into the
# built JavaScript — the browser holds no key at all, which is the reason the
# server exists.

# Chat: replies, streaming, and image generation — a Google AI Studio key.
GEMINI_API_KEY=

# Read aloud. A Cloud Text-to-Speech key, and NOT the same key as the one above;
# nothing can be spoken without it.
GOOGLE_CLOUD_TTS_KEY=

# Every /api/ai call carries a signed-in person's token and is checked against
# this project before the action runs.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# A sign-in screen will need this same project again in the browser, as
# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY — Vite inlines anything with that
# prefix into the built JavaScript, so those two are public by definition. They
# are not listed above yet because no browser code reads them yet, and a file
# that names a variable nothing reads is a file that lies.
